// Windows resources: icon, manifest and version information.
// Compiled by windres (MinGW) or rc.exe (MSVC); only used on Windows.

#include "version.h"

// Explorer and the taskbar use the alphabetically first icon of the .exe.
// "AppIcon" sorts before wxWidgets' own "wxICON_AAA", so it wins.
AppIcon ICON "app.ico"

// Standard wxWidgets resources (cursors, bitmaps ...), but without wx's
// manifest: we embed our own below (Windows 11 compatibility + DPI settings).
#define wxUSE_NO_MANIFEST 1
#include "wx/msw/wx.rc"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
PRODUCTVERSION  APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      APP_PUBLISHER
            VALUE "FileDescription",  APP_DISPLAY_NAME
            VALUE "FileVersion",      APP_VERSION_STRING
            VALUE "InternalName",     APP_TARGET_NAME
            VALUE "LegalCopyright",   APP_COPYRIGHT
            VALUE "OriginalFilename", APP_EXE_NAME
            VALUE "ProductName",      APP_DISPLAY_NAME
            VALUE "ProductVersion",   APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
